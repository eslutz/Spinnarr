{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spinnarr Multi-Spinner Schema",
  "description": "Schema for defining multiple spinners with items",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The title of the spinner collection"
    },
    "spinners": {
      "type": "array",
      "description": "Array of spinner configurations",
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The display name of the spinner"
          },
          "items": {
            "type": "array",
            "description": "Array of items to spin through",
            "items": {
              "type": "string",
              "description": "Item to display in the spinner"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["spinners"],
  "additionalProperties": false
}
